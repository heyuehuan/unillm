# --- Security (set these in any real deployment) ---
# JWT signing secret for the management API. If unset, the server generates a random
# ephemeral secret at startup (sessions won't survive restarts). Use a long random value.
UNILLM_JWT_SECRET="change-me-to-a-long-random-string"
# Fernet key used to encrypt stored API-key plaintext (for the reveal feature).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from UNILLM_JWT_SECRET.
UNILLM_ENCRYPTION_KEY=""
# Comma-separated CORS allowlist for the browser frontend, e.g. "https://app.example.com".
# Empty = same-origin only (recommended unless the UI is served from another origin).
UNILLM_CORS_ORIGINS=""
# Set to "true" only when running behind a trusted reverse proxy that sets
# X-Forwarded-For; otherwise client IPs in logs are spoofable.
UNILLM_TRUST_PROXY_HEADERS="false"

# --- First admin bootstrap ---
UNILLM_ADMIN_USERNAME=""
UNILLM_ADMIN_PASSWORD=""
# Set to "true" to re-sync the admin password/role from the env vars on every restart
# (off by default so a stray env var can't silently escalate an existing account).
UNILLM_ADMIN_SYNC="false"

# --- Env-var API keys (used when no database is configured) ---
UNILLM_MASTER_KEY="sk-1234"
UNILLM_API_KEYS="sk-key1,sk-key2,sk-key3"
